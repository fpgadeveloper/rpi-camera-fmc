&mipi_3_v_proc {
	compatible = "xlnx,v-vpss-scaler-2.2";
	reset-gpios = <&gpio1 85 1>;
};

&mipi_3_v_frmbuf_wr {
	reset-gpios = <&gpio1 86 1>;
};

/* Display pipeline (v_mix + v_tc -> DVI over HDMI): wired up by the dvi-out
 * layer (Yocto/bsp/dvi-out, dvi-out.dtsi), added via bblayers-extra.txt.
 * Mixer reset = PMC EMIO GPIO bit 1. */
&display_pipeline_v_mix_0 {
	reset-gpios = <&gpio1 53 1>;
};

/* Board RJ45 (GEM0 = u198 PHY): the SDT flow does not describe the
 * board-level PHY, so Linux falls back to the Generic PHY driver and the
 * RGMII clock delays are never programmed. The PHY at MDIO addr 1 differs by
 * board revision (official dts): revA TI DP83867 (RX 0xb / TX 0xa), revB ADI
 * ADIN1300 (RX/TX 2000 ps), so the node carries no PHY-ID compatible and each
 * driver reads only its own properties (as in the other Opsero VEK280 BSPs).
 * No fixed MAC yet: no bench MAC is allocated for VEK280 in
 * scripts/board_configs.json.
 */
&gem0 {
	phy-handle = <&gem0_phy>;
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		gem0_phy: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
			adi,rx-internal-delay-ps = <2000>;
			adi,tx-internal-delay-ps = <2000>;
			adi,fifo-depth-bits = <8>;
		};
	};
};
