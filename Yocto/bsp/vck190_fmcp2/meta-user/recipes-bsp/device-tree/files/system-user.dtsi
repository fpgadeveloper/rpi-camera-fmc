/* Display pipeline (v_mix + v_tc -> DVI over HDMI): wired up by the dvi-out
 * layer (Yocto/bsp/dvi-out, dvi-out.dtsi), added via bblayers-extra.txt.
 * Mixer reset = PMC EMIO GPIO bit 1. */
&display_pipeline_v_mix_0 {
	reset-gpios = <&gpio1 53 1>;
};

/* Board RJ45s (GEM0 = u198 PHY, GEM1 = u134 PHY): the SDT flow does not
 * describe the board-level TI DP83867 PHYs, so Linux falls back to the
 * Generic PHY driver and the RGMII clock delays are never programmed -
 * the link negotiates 1G but passes no packets. Both PHYs sit on GEM0's
 * MDIO bus. Values from the official versal-vmk180-revA.dts (which the
 * vck190 dts includes), as in the other Opsero VCK190 BSPs. Fixed MACs
 * (bench allocation, scripts/board_configs.json) keep DHCP leases stable.
 */
&gem0 {
	local-mac-address = [00 0a 35 06 21 90];
	phy-handle = <&gem0_phy>;
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		gem0_phy: ethernet-phy@1 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <1>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
		gem1_phy: ethernet-phy@2 {
			compatible = "ethernet-phy-id2000.a231";
			reg = <2>;
			ti,rx-internal-delay = <0xb>;
			ti,tx-internal-delay = <0xa>;
			ti,fifo-depth = <0x1>;
			ti,dp83867-rxctrl-strap-quirk;
		};
	};
};

&gem1 {
	local-mac-address = [00 0a 35 06 21 91];
	phy-handle = <&gem1_phy>;
};
